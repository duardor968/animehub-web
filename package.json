{
  "name": "animehub-web",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.20.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @animehub/web --filter @animehub/api dev",
    "dev:web": "pnpm --filter @animehub/web dev",
    "dev:api": "pnpm --filter @animehub/api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:generate": "pnpm --filter @animehub/api prisma:generate",
    "prisma:validate": "pnpm --filter @animehub/api prisma:validate"
  },
  "devDependencies": {
    "prettier": "3.9.6"
  }
}
